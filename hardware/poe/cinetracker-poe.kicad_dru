(version 1)
# PoE isolation (IEEE 802.3 clause 33.4.1 asks for 1500 V between the MDI and everything accessible).
# Primary = PoE side (net class Primary). Keep >= 2.6 mm from every other connected copper item.
# 2.6 mm is the smallest gap on the board: the pad gap of C5 (1812, 2 kV), which bridges the barrier on purpose.
# Copper with no net and no-connect pins (KiCad 10 names them unconnected-...) are left out, like before: T1's NC pins
# and J1 pin 9 (M12 housing contact, left open on purpose, see documentation/design-notes.md).
(rule "PoE isolation"
  (constraint clearance (min 2.6mm))
  (condition "A.NetClass == 'Primary' && B.NetClass != 'Primary' && B.NetName != '' && B.NetName != 'unconnected-*'"))

# M12 pin 9 (J1, housing contact): the housing sits on the chassis (= isolated GND) once the connector is panel
# mounted, so nothing on the board may come closer to it than the connector's own pins do (1.53 mm, pad to pad).
(rule "M12 housing contact"
  (constraint clearance (min 1.53mm))
  (condition "A.NetName == 'unconnected-(J1-SHIELD-Pad9)'"))
