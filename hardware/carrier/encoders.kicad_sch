    (effects (font (size 1.27 1.27)) (justify left))
    (uuid cf449db1-91ea-40dc-ac7a-109d0e24be03)
  )
  (text "AS5048A over SPI at 8 MHz MODE1 (focus on SPI, zoom on SPI1); AS5048B over I2C at 400 kHz (iris), 2 kohm pull-ups."
